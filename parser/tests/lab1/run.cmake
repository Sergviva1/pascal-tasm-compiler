if(CASE STREQUAL "T1" OR CASE STREQUAL "T2")
    set(expected_status 0)
else()
    set(expected_status 3)
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/expected/${CASE}.txt" expected)
if(DEFINED CLI)
    set(command "${CLI}" "${CMAKE_CURRENT_LIST_DIR}/${CASE}.pas")
else()
    set(command "${RUNNER}" "${CASE}")
endif()
execute_process(COMMAND ${command} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status STREQUAL "${expected_status}")
    message(FATAL_ERROR "${CASE}: код ${status}, ожидался ${expected_status}\n${output}${error}")
endif()
if(expected_status EQUAL 0)
    set(actual "${output}")
    set(unexpected "${error}")
else()
    set(actual "${error}")
    set(unexpected "${output}")
endif()
if(NOT actual STREQUAL expected OR NOT unexpected STREQUAL "")
    message(FATAL_ERROR "${CASE}: ожидалось\n${expected}\nполучено\n${actual}\nлишний вывод\n${unexpected}")
endif()
