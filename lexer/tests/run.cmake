execute_process(COMMAND "${CLI}" "${CMAKE_CURRENT_LIST_DIR}/T${N}.pas"
    RESULT_VARIABLE rc OUTPUT_VARIABLE tokens ERROR_VARIABLE diagnostic)
if(N LESS 3)
    if(NOT rc STREQUAL "0" OR NOT tokens MATCHES "EOF")
        message(FATAL_ERROR "T${N}: ${rc} ${diagnostic}\n${tokens}")
    endif()
else()
    if(N EQUAL 3)
        set(pos "4, столбец 9")
    else()
        set(pos "3, столбец 11")
    endif()
    if(NOT rc STREQUAL "2" OR NOT diagnostic MATCHES "${pos}")
        message(FATAL_ERROR "T${N}: ${rc} ${diagnostic}")
    endif()
endif()
